@code {
    private bool isLightMode = false;
    private string manilaTimePht = "";
    private System.Threading.Timer? clockTimer;
    private string commandInput = "";
    private List<(string Command, string Response)> historyLogs = new();

    protected override void OnInitialized()
    {
        UpdateManilaTime();
        clockTimer = new System.Threading.Timer(_ =>
        {
            UpdateManilaTime();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void UpdateManilaTime()
    {
        var manilaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time"); // UTC+8 Manila
        var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, manilaTimeZone);
        manilaTimePht = now.ToString("HH:mm:ss") + " PHT";
    }

    private void ToggleTheme()
    {
        isLightMode = !isLightMode;
    }

    private void RunPresetCommand(string cmd)
    {
        var response = GetCommandResponse(cmd);
        historyLogs.Add((cmd, response));
    }

    private void HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(commandInput))
        {
            var cmd = commandInput.Trim().ToLower();
            var response = GetCommandResponse(cmd);
            historyLogs.Add((commandInput, response));
            commandInput = "";
        }
    }

    private string GetCommandResponse(string cmd)
    {
        return cmd switch
        {
            "help" => "Available commands: whoami, skills, projects, capstone, ba, qa, n8n, contact, clear",
            "whoami" => "Dave L. Cleofe — Junior .NET Software Engineer | Systems Analyst & QA (STI College Caloocan).",
            "skills" => "C#, MS SQL Server, ASP.NET Core MVC, ASP.NET Web API, .NET MAUI, Blazor, WinForms, MAF, n8n, Supabase, Neon DB.",
            "projects" => "EVOTECH: 1. Enterprise HRIS AI Assistant (MAF, OpenAI RAG). 2. Core HRMS Web API & SQL Stored Procedures. 3. n8n Automation Lab.",
            "capstone" => "I AM: AR Human Anatomy Mobile App — Lead Architect for Unity 3D, C#, Firebase, and Teacher Web Portal.",
            "ba" => "Business Analysis: Led requirement gathering, identified client pain points, process mapping, and module architecture at EVOTECH.",
            "qa" => "Quality Assurance: API integration testing via Postman, prototype testing, system debugging, and performance optimization.",
            "n8n" => "n8n Automation: Building automated workflow pipelines connecting Web APIs, webhooks, AI agents, and database mutations.",
            "contact" => "Email: contact.doss30@gmail.com | Phone: +63 993 899 0154 | GitHub: github.com/Dows30",
            "clear" => ClearHistory(),
            _ => $"command not found: {cmd}. Type 'help' for available commands."
        };
    }

    private string ClearHistory()
    {
        historyLogs.Clear();
        return "Terminal output cleared.";
    }

    public void Dispose()
    {
        clockTimer?.Dispose();
    }
}


